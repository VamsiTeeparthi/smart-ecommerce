# URL of your deployed FastAPI backend (no /api, no trailing slash)
BACKEND_URL=http://localhost:8000
# An ADMIN account of your store (see README: a dedicated one is recommended)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Long random secret that protects this MCP server. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET=
# false = Claude can only READ. Set true to let Claude add/update things.
ALLOW_WRITES=false
